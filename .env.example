# Banco de dados (Neon / PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Autenticacao
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Pagamentos (Asaas)
ASAAS_API_KEY=""
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"

# Webhook do Asaas: token que voce define no painel do Asaas e cola aqui.
# O Asaas envia esse valor no cabecalho asaas-access-token de cada notificacao.
# Sem ele a rota /api/payments/asaas/webhook recusa tudo com 503.
# Eventos a habilitar no webhook: Cobrancas (PAYMENT_*), Checkout (CHECKOUT_*)
# e Assinaturas (SUBSCRIPTION_*). URL: https://<seu-dominio>/api/payments/asaas/webhook
ASAAS_WEBHOOK_TOKEN=""

# E-mail de confirmacao de agendamento (Resend - https://resend.com)
# Sem RESEND_API_KEY o agendamento continua funcionando, apenas nao envia e-mail.
RESEND_API_KEY=""
# Remetente. Precisa de dominio verificado na Resend.
# Para testes, use: "Elemento Estudio e Barbearia <onboarding@resend.dev>"
EMAIL_FROM="Elemento Estudio e Barbearia <contato@seudominio.com.br>"

# URL publica do site, usada para montar o link do arquivo .ics no e-mail.
NEXT_PUBLIC_SITE_URL="https://seudominio.com.br"
